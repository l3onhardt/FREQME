# MiMo API (TTS + LLM via OpenAI-compatible Chat Completions)
MIMO_API_KEY=tp-xxx
MIMO_API_BASE=https://token-plan-sgp.xiaomimimo.com/v1

# TTS Settings
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖

# LLM Settings (MiMo as primary - set LLM_MODEL to a MiMo text model like mimo-v2-pro)
LLM_PROVIDER=mimo
LLM_API_KEY=tp-xxx
LLM_MODEL=mimo-v2.5-tts
LLM_API_BASE=https://token-plan-sgp.xiaomimimo.com/v1

# LLM Fallback
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_API_KEY=sk-ant-xxx
LLM_FALLBACK_MODEL=claude-sonnet-4-6

# NetEase Bridge
NETEASE_BRIDGE_PORT=3000
MAX_DAILY_TOKENS=100000
