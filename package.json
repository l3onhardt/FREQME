{
  "name": "freqme",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run start:local",
    "dev:watch": "node --watch --loader ts-node/esm src/server.ts",
    "build": "tsc -p tsconfig.json --noCheck",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "start:local": "node scripts/start-local.mjs",
    "test": "npm run build:test && node --test dist/tests/ts/*.test.js tests/js/*.test.mjs netease-bridge/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
